AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Bedrock foundation model the agent reasons with (no fine-tuning required)
BEDROCK_AGENT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
HF_DATASET=Taylor658/deep-space-optical-chip-thermal-dataset

# --- Open-weight fine-tuning (optional) ---
# HuggingFace token (required for gated bases like Llama 3.3)
HF_TOKEN=your_huggingface_token_here
# Artifacts the SFT trace builder grounds tool results with
# (loaded if present, otherwise trained/built on the fly)
CLASSIFIER_PATH=results/strategy_classifier.pkl
INDEX_PATH=results/thermal_datastore.pkl
# OpenAI-compatible endpoint serving your fine-tuned GGUF model (provider: local)
LOCAL_MODEL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL_NAME=thermal-agent
LOCAL_MODEL_API_KEY=not-needed
